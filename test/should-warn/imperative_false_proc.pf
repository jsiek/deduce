// Phase 1m (issue #1108): a deliberately false procedure must not pass
// silently. `ensures result = true` with `return false` is unsound, but the
// Phase 2 verifier has not landed yet, so the checker still accepts the
// declaration. Instead of reporting it valid with no comment, it now emits an
// "accepted but not verified" warning so the unchecked contract is visible.
proc always_false() -> bool
  ensures result = true
{
  return false
}
