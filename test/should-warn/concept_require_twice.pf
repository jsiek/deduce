// Requiring two instances of one concept brings its associated type Elem
// in twice; the user didn't write either name, so there is no warning
// (#1346). An associated type that replaces a type parameter the user
// wrote still warns.

concept Iter<I> {
  type Elem
  fun deref : fn I -> Elem
}

concept SameIter<X, Y> {
  require Iter<X>
  require Iter<Y>
  X = Y
}

concept ShadowParam<Elem, I> {
  require Iter<I>
}
