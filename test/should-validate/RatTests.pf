import Rat

// Concrete arithmetic

assert frac(+2, 4) = frac(+1, 2)
assert frac(-6, 4) = - frac(+3, 2)
assert frac(+5, 0) = rat(+0)
assert num(frac(-6, 4)) = -3
assert den(frac(-6, 4)) = 2
assert rat(3) = rat(+3)
assert frac(+1, 2) + frac(+1, 3) = frac(+5, 6)
assert frac(+1, 2) - frac(+3, 4) = frac(-1, 4)
assert frac(+1, 2) * frac(+2, 3) = frac(+1, 3)
assert frac(+1, 2) / frac(+3, 4) = frac(+2, 3)
assert inv(frac(-2, 3)) = frac(-3, 2)
assert frac(+7, 3) / rat(+0) = rat(+0)
assert rat(+360) * frac(+1, 360) = rat(+1)
assert frac(+1, 3) < frac(+1, 2)
assert frac(-1, 2) ≤ frac(-1, 3)
assert not (frac(+1, 2) ≤ frac(+1, 3))
assert abs(frac(-5, 7)) = frac(+5, 7)
assert max(frac(+1, 3), frac(+1, 2)) = frac(+1, 2)
assert min(frac(+1, 3), frac(+1, 2)) = frac(+1, 3)

print frac(+6, 8)
print frac(-10, 5)
print rat(+0)

// Ordered-field axioms as theorems

theorem field_axioms: all x:Rat, y:Rat, z:Rat.
  x + y = y + x
  and (x + y) + z = x + (y + z)
  and x + rat(+0) = x
  and x + - x = rat(+0)
  and x * y = y * x
  and (x * y) * z = x * (y * z)
  and x * rat(+1) = x
  and (if not (x = rat(+0)) then x * inv(x) = rat(+1))
  and x * (y + z) = x * y + x * z
  and not (rat(+1) = rat(+0))
proof
  arbitrary x:Rat, y:Rat, z:Rat
  rat_add_commute[x, y], rat_add_assoc[x, y, z], rat_add_zero[x], rat_add_inverse[x],
  rat_mult_commute[x, y], rat_mult_assoc[x, y, z], rat_mult_one[x], rat_mult_inv[x],
  rat_dist_mult_add[x, y, z], rat_one_not_zero
end

theorem order_axioms: all x:Rat, y:Rat, z:Rat.
  x ≤ x
  and (if x ≤ y and y ≤ z then x ≤ z)
  and (if x ≤ y and y ≤ x then x = y)
  and (x ≤ y or y < x)
  and (x < y or x = y or y < x)
  and (if x ≤ y then x + z ≤ y + z)
  and (if rat(+0) ≤ x and rat(+0) ≤ y then rat(+0) ≤ x * y)
proof
  arbitrary x:Rat, y:Rat, z:Rat
  have add_mono: if x ≤ y then x + z ≤ y + z by {
    assume x_y
    replace rat_add_both_sides_of_less_equal_right
    x_y
  }
  rat_less_equal_refl[x], rat_less_equal_trans[x, y, z],
  rat_less_equal_antisymmetric[x, y], rat_dichotomy[x, y], rat_trichotomy[x, y],
  add_mono, rat_mult_nonneg[x, y]
end

// A small algebraic proof: (x + y)^2 = x^2 + 2xy + y^2

theorem square_of_sum: all x:Rat, y:Rat.
  (x + y) * (x + y) = x * x + rat(+2) * x * y + y * y
proof
  arbitrary x:Rat, y:Rat
  have two: rat(+2) * x = x + x by {
    replace symmetric rat_int_add[+1, +1] | rat_dist_mult_add_right.
  }
  replace two | rat_dist_mult_add | rat_dist_mult_add_right
        | rat_mult_commute[y, x].
end

// The embedding of the integers preserves the operations.

theorem int_embedding: all n:Int, m:Int.
  rat(n) + rat(m) = rat(n + m)
  and rat(n) * rat(m) = rat(n * m)
  and - rat(n) = rat(- n)
  and (rat(n) ≤ rat(m)) = (n ≤ m)
  and num(rat(n)) = n and den(rat(n)) = 1
proof
  arbitrary n:Int, m:Int
  rat_int_add[n, m], rat_int_mult[n, m], rat_int_neg[n], rat_int_le[n, m],
  rat_num_int[n], rat_den_int[n]
end

// Fractions are quotients of integers.

theorem frac_is_division: all n:Int, d:UInt. frac(n, d) = rat(n) / rat(pos(d))
proof
  rat_frac_div
end

// Absolute value

theorem triangle: all x:Rat, y:Rat. abs(x + y) ≤ abs(x) + abs(y)
proof
  rat_abs_add
end

// Midpoint lies between its endpoints.

theorem midpoint_between: all a:Rat, b:Rat.
  if a ≤ b then a ≤ frac(+1, 2) * (a + b)
proof
  arbitrary a:Rat, b:Rat
  assume a_b
  have two_pos: (0:UInt) < 2 by .
  have half: frac(+1, 2) * (a + a) = a by {
    have two: a + a = rat(+2) * a by {
      replace symmetric rat_int_add[+1, +1] | rat_dist_mult_add_right.
    }
    have h: frac(+1, 2) * rat(+2) = rat(+1) by {
      replace rat_int_frac[+2] | apply rat_mult_frac[+1, 2, +2, 1] to two_pos, .
      apply rat_frac_self[2] to two_pos
    }
    replace two | h.
  }
  have h1: a + a ≤ a + b by { replace rat_add_both_sides_of_less_equal  a_b }
  have h2: frac(+1, 2) * (a + a) ≤ frac(+1, 2) * (a + b)
    by apply rat_nonneg_mult_mono_le_left[frac(+1, 2), a + a, a + b]
       to (replace apply rat_zero_le_frac[+1, 2] to two_pos.), h1
  replace half in h2
end
