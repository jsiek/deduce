// Same-type constraints (#1321): inside the where clause, the two
// associated types are the same type, so an element taken from one
// container can be put into the other.

import ConceptContainer
import Pair

model Container<bool> {
  type Elem = bool
  fun get = fun b:bool { b }
  fun put = fun b:bool { b }
  theorem get_put = { arbitrary x:bool  evaluate }
}

model Container<Pair<bool,bool>> {
  type Elem = bool
  fun get = fun p:Pair<bool,bool> { first(p) }
  fun put = fun b:bool { pair(b, b) }
  theorem get_put = { arbitrary x:bool  evaluate }
}

theorem transfer: all C:type, D:type
    where { Container<C>, Container<D>,
            @Container<C>.Elem = @Container<D>.Elem }.
  all c:C. get(@Container<D>.put(get(c))) = get(c)
proof
  arbitrary C:type, D:type
    where { Container<C>, Container<D>,
            @Container<C>.Elem = @Container<D>.Elem }
  arbitrary c:C
  @Container<D>.get_put[get(c)]
end

// Both models have Elem = bool.
theorem transfer_pair: all b:bool.
  @Container<Pair<bool,bool>>.get(@Container<Pair<bool,bool>>.put(
    @Container<bool>.get(b))) = @Container<bool>.get(b)
proof
  transfer<bool, Pair<bool,bool>>
end

// A constraint can give an associated type a concrete type.
theorem put_true: all C:type where { Container<C>, @Container<C>.Elem = bool }.
  get(put(true)) = true
proof
  arbitrary C:type where { Container<C>, @Container<C>.Elem = bool }
  get_put[true]
end

theorem put_true_pair:
  @Container<Pair<bool,bool>>.get(@Container<Pair<bool,bool>>.put(true)) = true
proof
  put_true<Pair<bool,bool>>
end

// Equal types built with the same constructor have equal parts.
theorem decompose: all C:type, D:type
    where { Container<C>, Container<D>,
            Pair<@Container<C>.Elem, bool> = Pair<@Container<D>.Elem, bool> }.
  all x:@Container<C>.Elem. get(@Container<D>.put(x)) = x
proof
  arbitrary C:type, D:type
    where { Container<C>, Container<D>,
            Pair<@Container<C>.Elem, bool> = Pair<@Container<D>.Elem, bool> }
  arbitrary x:@Container<C>.Elem
  @Container<D>.get_put[x]
end

// An inner where clause can give its own associated type an outer one.
theorem nested: all C:type where { Container<C> }.
  all D:type where { Container<D>, @Container<D>.Elem = @Container<C>.Elem }.
  all c:C. get(@Container<D>.put(get(c))) = get(c)
proof
  arbitrary C:type where { Container<C> }
  arbitrary D:type where { Container<D>, @Container<D>.Elem = @Container<C>.Elem }
  arbitrary c:C
  @Container<D>.get_put[get(c)]
end
