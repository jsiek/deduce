// An overloaded constant (`zero` is both a Nat and a UInt-view constructor)
// takes its type from its context, wherever that context is
// (issues #1232, #1236).
import Nat
import UInt
import List

// Generic calls: the other arguments fix the type argument, then the
// constant resolves against it, also when it is nested in an argument.
assert node(zero, node(suc(zero), empty)) = node(zero, node(suc(zero), empty))
assert node(suc(zero), node(zero, empty)) = node(suc(zero), node(zero, empty))
assert length(node(zero, node(suc(zero), empty))) = 2
assert length(node(zero, empty) ++ node(suc(zero), empty)) = 2

// Equality takes the type from whichever side has one.
assert zero ≠ suc(zero)
assert suc(zero) ≠ zero

// Conditional branches and switch bodies.
assert (if true then node(zero, empty) else node(suc(zero), empty)) = [zero]

fun pick(b : bool) {
  switch b {
    case true { zero }
    case false { suc(zero) }
  }
}
assert pick(true) = zero

theorem overload_constant_type_arg: all xs:List<Nat>.
  length(node(zero, xs)) = 1 + length(xs)
proof
  arbitrary xs:List<Nat>
  expand length.
end

theorem overload_constant_eq_left: not (zero = suc(zero))
proof
  .
end
