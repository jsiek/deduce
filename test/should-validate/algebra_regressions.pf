// Regressions for the `algebra` tactic.

import UInt
import Real
import Ring
import Linear

// #1335: `algebra` after a `define` in the proof.
theorem algebra_after_define: all a:Real, b:Real.
  a * b - b * a = real(+0)
proof
  arbitrary a:Real, b:Real
  define s = a * b
  have e: s - b * a = real(+0) by {
    expand s
    algebra
  }
  e
end

// #1336: refuting the givens when the first given is not about numbers.
theorem algebra_false_mixed: all n:UInt, x:Real.
  if n = 1 and x < real(+0) and real(+0) < x then false
proof
  arbitrary n:UInt, x:Real
  assume h
  algebra
end

// #1337: a negative literal such as `real(-1)` is a constant.
theorem algebra_negative_literal: all x:Real.
  if real(+1) + x = real(+0) then x = real(-1)
proof
  arbitrary x:Real
  assume h
  algebra
end

// #1348: `replace` leaves a sum or product flattened into one n-ary
// call, which linear mode reads term by term, not as one atom.
postulate nary_sum: all p:Real, q:Real, r:Real, s:Real. p + q + r = s * s

theorem algebra_replace_nary_sum: all p:Real, q:Real, r:Real, s:Real.
  if s = real(+0) and real(+0) < p and real(+0) < q and real(+0) < r
  then false
proof
  arbitrary p:Real, q:Real, r:Real, s:Real
  assume h
  have hs: s = real(+0) by conjunct 0 of h
  algebra with replace hs in nary_sum[p, q, r, s]
end

postulate nary_product: all x:Real, y:Real, z:Real. real(+2) * x * y + z = real(+0)

theorem algebra_replace_nary_product: all x:Real, y:Real, z:Real.
  if real(+0) < x * y and z = real(+0) then false
proof
  arbitrary x:Real, y:Real, z:Real
  assume h
  have hz: z = real(+0) by conjunct 1 of h
  algebra with replace hz in nary_product[x, y, z]
end
