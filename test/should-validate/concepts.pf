// Concepts, models, and where clauses (#1264): a theorem proved once
// under a where clause, used at a type through its model.

concept Monoid<T> {
  fun operator+ : fn (T, T) -> T
  fun zero : T
  theorem add_zero: all x:T. x + zero = x
  theorem zero_add: all x:T. zero + x = x
}

concept CommMonoid<T> {
  refines Monoid<T>
  theorem add_commute: all x:T, y:T. x + y = y + x
}

fun bor(a:bool, b:bool) { a or b }

theorem bor_false: all x:bool. bor(x, false) = x
proof
  arbitrary x:bool
  switch x {
    case true { evaluate }
    case false { evaluate }
  }
end

theorem false_bor: all x:bool. bor(false, x) = x
proof
  arbitrary x:bool
  switch x {
    case true { evaluate }
    case false { evaluate }
  }
end

theorem bor_commute: all x:bool, y:bool. bor(x, y) = bor(y, x)
proof
  arbitrary x:bool, y:bool
  switch x {
    case true { switch y { case true { evaluate } case false { evaluate } } }
    case false { switch y { case true { evaluate } case false { evaluate } } }
  }
end

// `operator+` is given; `zero` could be left out if a `zero : bool`
// were in scope.
model Monoid<bool> {
  fun operator+ = bor
  fun zero = false
  theorem add_zero = bor_false
  theorem zero_add = false_bor
}

// The refined concept's model is found in scope (F^G's MDL rule).
model CommMonoid<bool> {
  theorem add_commute = bor_commute
}

// Inside the where clause, `+`, `zero`, and the axioms are in scope.
theorem zero_zero: all T:type where { Monoid<T> }. (zero:T) + zero = zero
proof
  arbitrary T:type where { Monoid<T> }
  add_zero[zero]
end

// A refined concept's members are in scope too.
theorem swap_zero: all U:type where { CommMonoid<U> }. all a:U. zero + a = a + zero
proof
  arbitrary U:type where { CommMonoid<U> }
  arbitrary a:U
  add_commute[zero, a]
end

// Instantiating passes the model; its operations unfold to `bor` and
// `false`.
theorem bor_false_false: bor(false, false) = false
proof
  zero_zero<bool>
end

theorem bor_swap: all b:bool. bor(false, b) = bor(b, false)
proof
  swap_zero<bool>
end

// A where clause after several type variables stays with them when the
// earlier ones are introduced or instantiated.
theorem zero_zero_second: all T:type, U:type where { Monoid<U> }.
  all x:T. (zero:U) + zero = zero
proof
  arbitrary T:type, U:type where { Monoid<U> }
  arbitrary x:T
  add_zero[zero]
end

theorem bor_false_false_again: all n:bool. bor(false, false) = false
proof
  zero_zero_second<bool, bool>
end

// Two instances of one concept: `add_zero` names both instances' theorem,
// and each use resolves to the one that fits.
theorem zero_zero_both: all T:type, U:type where { Monoid<T>, Monoid<U> }.
  all x:T, y:U. x + zero = x and y + zero = y
proof
  arbitrary T:type, U:type where { Monoid<T>, Monoid<U> }
  arbitrary x:T, y:U
  have hx: x + zero = x by add_zero[x]
  have hy: y + zero = y by {
    replace add_zero
    .
  }
  hx, hy
end

theorem bor_zero_both: all a:bool, b:bool. bor(a, false) = a and bor(b, false) = b
proof
  zero_zero_both<bool, bool>
end

// A where clause's theorem names add to the overloads of an outer
// theorem with the same name, rather than hiding it.
theorem zero_add: all b:bool. bor(false, b) = b
proof
  false_bor
end

theorem zero_add_both: all T:type where { Monoid<T> }.
  all x:T. zero + x = x and bor(false, true) = true
proof
  arbitrary T:type where { Monoid<T> }
  arbitrary x:T
  zero_add[x], zero_add[true]
end

// A where theorem used without its type: `replace` infers it from the
// models in scope (here only Monoid<bool>) by what it can rewrite.
theorem bor_replace_inferred: bor(bor(false, false), true) = bor(false, true)
proof
  replace zero_zero
  .
end

// Inference finds a type variable nested in a constraint's type
// argument: `Pointed<Box<T>>` against the model `Pointed<Box<bool>>`.
union Box<T> {
  box(T)
}

concept Pointed<T> {
  fun pt : T
  fun ok : fn T -> bool
  theorem pt_ok: ok(pt)
}

fun unbox(b:Box<bool>) {
  switch b {
    case box(x) { x }
  }
}

model Pointed<Box<bool>> {
  fun pt = box(true)
  fun ok = unbox
  theorem pt_ok = { expand unbox. }
}

theorem boxed_ok: all T:type where { Pointed<Box<T>> }. ok((pt:Box<T>))
proof
  arbitrary T:type where { Pointed<Box<T>> }
  pt_ok
end

theorem unbox_box_true: unbox(box(true))
proof
  boxed_ok
end

// Qualified access `@C<τ>.m` names one instance's member.

// Inside a where clause: the clause's member for that instance.
theorem qualified_in_where: all T:type, U:type where { Monoid<T>, Monoid<U> }.
  @Monoid<U>.zero + @Monoid<U>.zero = @Monoid<U>.zero
proof
  arbitrary T:type, U:type where { Monoid<T>, Monoid<U> }
  @Monoid<U>.add_zero[@Monoid<U>.zero]
end

// Outside: the model's member, unfolded since the model is visible.
theorem qualified_model_zero: @Monoid<bool>.zero = false
proof
  .
end

theorem qualified_model_theorem: all x:bool. bor(x, false) = x
proof
  @Monoid<bool>.add_zero
end

// Nested where clauses binding the same instance: `@C<τ>.m` names the
// innermost clause's member.
theorem nested_qualified: all T:type where { Pointed<T> }.
  all U:type where { Pointed<T> }. @Pointed<T>.ok(@Pointed<T>.pt)
proof
  arbitrary T:type where { Pointed<T> }
  arbitrary U:type where { Pointed<T> }
  @Pointed<T>.pt_ok
end
