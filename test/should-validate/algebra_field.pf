// The field mode of the `algebra` tactic (#1322): inverses, quotients,
// and fraction constants over Rat, Real, and any type that models Field.
// The side conditions, that the inverted factors are nonzero, are
// givens or follow from them by the linear mode.

import Ring
import Linear

// A side condition for a constant: `real(+2) ≠ real(+0)`.
theorem half_sum: all x:Real, y:Real.
  (x + y) / real(+2) = x / real(+2) + y / real(+2)
proof
  arbitrary x:Real, y:Real
  algebra
end

// A side condition that is a given.
theorem div_mult_cancel: all x:Real, y:Real.
  if not (y = real(+0)) then x / y * y = x
proof
  arbitrary x:Real, y:Real
  assume hy
  algebra
end

// Side conditions that follow from the givens: `b ≠ rat(+0)` from
// `rat(+0) < b`.
theorem div_add_div: all a:Rat, b:Rat, c:Rat, d:Rat.
  if rat(+0) < b and rat(+0) < d
  then a / b + c / d = (a * d + c * b) / (b * d)
proof
  arbitrary a:Rat, b:Rat, c:Rat, d:Rat
  assume h
  algebra
end

theorem inv_mult: all x:Real, y:Real.
  if not (x = real(+0)) and not (y = real(+0))
  then inv(x * y) * x = inv(y)
proof
  arbitrary x:Real, y:Real
  assume h
  algebra
end

theorem div_div: all x:Real, y:Real, z:Real, w:Real.
  if not (y = real(+0)) and not (z = real(+0)) and not (w = real(+0))
  then (x / y) / (z / w) = (x * w) / (y * z)
proof
  arbitrary x:Real, y:Real, z:Real, w:Real
  assume h
  algebra
end

theorem div_pow: all x:Real, y:Real.
  if not (y = real(+0)) then (x / y) ^ (2:UInt) = x ^ (2:UInt) / (y * y)
proof
  arbitrary x:Real, y:Real
  assume h
  algebra
end

// A given written the other way around.
theorem inv_square: all x:Rat.
  if not (rat(+0) = x) then inv(x) ^ (2:UInt) * x * x = rat(+1)
proof
  arbitrary x:Rat
  assume h
  algebra
end

theorem sum_over_sum: all x:Real, y:Real.
  if real(+0) < x + y then (x + y) / (x + y) = real(+1)
proof
  arbitrary x:Real, y:Real
  assume h
  algebra
end

// Fraction constants.
theorem rat_halves: all x:Rat. frac(+1, 2) * x + frac(+1, 2) * x = x
proof
  arbitrary x:Rat
  algebra
end

theorem real_half: all x:Real, y:Real.
  real(frac(+1, 2)) * (x + y) = x / real(+2) + y / real(+2)
proof
  arbitrary x:Real, y:Real
  algebra
end

theorem rat_thirds: all x:Rat. frac(-1, 3) * x + frac(+2, 3) * x = frac(+1, 3) * x
proof
  arbitrary x:Rat
  algebra
end

// Proved once for every field.
theorem field_half: all T:type where { Field<T> }. all x:T.
  if not (one + one = zero) then x / (one + one) + x / (one + one) = x
proof
  arbitrary T:type where { Field<T> }
  arbitrary x:T
  assume h
  algebra
end
