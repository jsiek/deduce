// Step 14: an array out-of-bounds at runtime panics with a message
// that includes the original `.pf:line`. The out-of-bounds `A[suc(zero)]`
// is an argument that `ignore` doesn't use: the interpreter leaves it
// un-reduced and prints `true`, but the compiled binary evaluates
// arguments first, so it panics. The harness compares only the panic
// substring.
//
// expected-runtime-error: source_map.pf:

union MyNat {
  zero
  suc(MyNat)
}

union List<T> {
  empty
  node(T, List<T>)
}

define A = array(node(zero, empty))

fun ignore(x : MyNat) { true }

print ignore(A[suc(zero)])
