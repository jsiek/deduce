// `require Eq<Elem>` (#1321): a model of Container<bool> with
// `type Elem = bool` needs a model of Eq<bool>, and there is none. This
// file also exercises the rest of the syntax of associated types: `type`
// members of a concept and a model, the projection `@C<τ>.Elem`, and a
// same-type constraint.

concept Eq<T> {
  fun eq : fn (T, T) -> bool
}

concept Container<C> {
  type Elem
  require Eq<Elem>
  fun first : fn C -> Elem
}

model Container<bool> {
  type Elem = bool
  fun first = fun b:bool { b }
}

theorem same_first: all C:type, D:type
    where { Container<C>, Container<D>,
            @Container<C>.Elem = @Container<D>.Elem }.
  all c:C, d:D. if first(c) = first(d) then first(d) = first(c)
proof
  sorry
end
