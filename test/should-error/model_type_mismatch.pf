// The operations of a model must have the concept's types at the model's
// associated types (#1321): with Elem = bool, `get` must return a bool.

import ConceptContainer
import Pair

model Container<Pair<bool, bool>> {
  type Elem = bool
  fun get = fun p:Pair<bool,bool> { p }
  fun put = fun b:bool { pair(b, b) }
  theorem get_put = { arbitrary x:bool  evaluate }
}
