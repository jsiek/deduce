// A user-defined `+` over a user type shaped like Nat literals must
// not be computed by the native Nat `lit` fast path.
union N { zero  suc(N) }
fun lit(a : N) { a }
fun operator +(a : N, b : N) { (zero : N) }
theorem bogus: lit(suc((zero : N))) + lit(suc((zero : N))) = lit(suc(suc((zero : N))))
proof
  .
end
