module Ring

/*
  Ring normalization for the `algebra` tactic (#1190).

  `algebra` proves an equation `a = b` whose sides are equal as
  polynomials. It writes each side as an expression (`RExpr`) over
  atoms, the maximal subterms that are not sums, products, constants,
  powers with a literal exponent, or (in a ring) differences and
  negations, and instantiates
  `semiring_prove` or `ring_prove` at the goal's type. The checker
  evaluates the normal forms of both expressions and the denotation of
  each, so the premise becomes `true` and the conclusion the goal as the
  user wrote it; nothing about the tactic is trusted.

  A normal form is a list of monomials `mono(c, es)`: the coefficient
  `c`, a natural number, times the product of the atoms raised to the
  exponents `es` (atom 0 first). The list is sorted by `ring_mono_less`
  and has no zero coefficients, so equal polynomials have equal normal
  forms. In a ring, an expression is normalized to two such polynomials
  `P` and `N`, its value being `P - N`, and `a = b` holds when
  `P(a) + N(b)` and `P(b) + N(a)` have the same normal form.
*/

// The tactic builds expressions from lists and Nat indices, so their
// names must be in scope wherever this is.
public import UInt
public import Nat
public import Int
import Base
public import List
public import Algebra

union RExpr {
  rvar(Nat)
  rzero
  rone
  rconst(Nat)
  radd(RExpr, RExpr)
  rsub(RExpr, RExpr)
  rneg(RExpr)
  rmul(RExpr, RExpr)
  rpow(RExpr, UInt)
}

recursive ring_get<T> where { CommSemiring<T> } (List<T>, Nat) -> T {
  ring_get(empty, i) = zero
  ring_get(node(x, xs), i) =
    switch i { case zero { x } case suc(j) { ring_get(xs, j) } }
}

fun ring_tail<T>(xs : List<T>) {
  switch xs { case empty { xs } case node(y, ys) { ys } }
}

// In a semiring, differences and negations are not normalized; the
// tactic leaves them in atoms.
recursive ring_sdenote<T> where { CommSemiring<T> } (RExpr, List<T>) -> T {
  ring_sdenote(rvar(i), env) = ring_get(env, i)
  ring_sdenote(rzero, env) = zero
  ring_sdenote(rone, env) = one
  ring_sdenote(rconst(n), env) = from_nat(n)
  ring_sdenote(radd(a, b), env) = ring_sdenote(a, env) + ring_sdenote(b, env)
  ring_sdenote(rsub(a, b), env) = zero
  ring_sdenote(rneg(a), env) = zero
  ring_sdenote(rmul(a, b), env) = ring_sdenote(a, env) * ring_sdenote(b, env)
  ring_sdenote(rpow(a, k), env) = ring_sdenote(a, env) ^ k
}

recursive ring_denote<T> where { CommRing<T> } (RExpr, List<T>) -> T {
  ring_denote(rvar(i), env) = ring_get(env, i)
  ring_denote(rzero, env) = zero
  ring_denote(rone, env) = one
  ring_denote(rconst(n), env) = from_nat(n)
  ring_denote(radd(a, b), env) = ring_denote(a, env) + ring_denote(b, env)
  ring_denote(rsub(a, b), env) = ring_denote(a, env) - ring_denote(b, env)
  ring_denote(rneg(a), env) = - ring_denote(a, env)
  ring_denote(rmul(a, b), env) = ring_denote(a, env) * ring_denote(b, env)
  ring_denote(rpow(a, k), env) = ring_denote(a, env) ^ k
}

/********************** Normal forms **********************/

union Mono { mono(Nat, List<Nat>) }

// The product of two monomials adds their exponents.
recursive ring_vadd(List<Nat>, List<Nat>) -> List<Nat> {
  ring_vadd(empty, ys) = ys
  ring_vadd(node(x, xs), ys) =
    switch ys {
      case empty { node(x, xs) }
      case node(y, ys2) { node(x + y, ring_vadd(xs, ys2)) }
    }
}

recursive ring_vunit(Nat) -> List<Nat> {
  ring_vunit(zero) = [suc(zero)]
  ring_vunit(suc(i)) = node(zero, ring_vunit(i))
}

recursive ring_mono_less(List<Nat>, List<Nat>) -> bool {
  ring_mono_less(empty, ys) = switch ys { case empty { false } case node(y, ys2) { true } }
  ring_mono_less(node(x, xs), ys) =
    switch ys {
      case empty { false }
      case node(y, ys2) { if x = y then ring_mono_less(xs, ys2) else x < y }
    }
}

// Add the monomial `c` times `m`.
recursive ring_insert(List<Mono>, Nat, List<Nat>) -> List<Mono> {
  ring_insert(empty, c, m) = [mono(c, m)]
  ring_insert(node(t, ps), c, m) =
    switch t {
      case mono(d, m2) {
        if m = m2 then node(mono(c + d, m), ps)
        else if ring_mono_less(m, m2) then node(mono(c, m), node(t, ps))
        else node(t, ring_insert(ps, c, m))
      }
    }
}

recursive ring_add(List<Mono>, List<Mono>) -> List<Mono> {
  ring_add(empty, qs) = qs
  ring_add(node(t, ps), qs) =
    switch t { case mono(c, m) { ring_insert(ring_add(ps, qs), c, m) } }
}

// Multiply by the monomial `c` times `m`.
recursive ring_scale(List<Mono>, Nat, List<Nat>) -> List<Mono> {
  ring_scale(empty, c, m) = empty
  ring_scale(node(t, ps), c, m) =
    switch t {
      case mono(d, m2) { node(mono(c * d, ring_vadd(m, m2)), ring_scale(ps, c, m)) }
    }
}

recursive ring_mul(List<Mono>, List<Mono>) -> List<Mono> {
  ring_mul(empty, qs) = empty
  ring_mul(node(t, ps), qs) =
    switch t { case mono(c, m) { ring_add(ring_scale(qs, c, m), ring_mul(ps, qs)) } }
}

recursive ring_npow(Nat, List<Mono>) -> List<Mono> {
  ring_npow(zero, ps) = [mono(suc(zero), [])]
  ring_npow(suc(n), ps) = ring_mul(ps, ring_npow(n, ps))
}

recursive ring_norm(RExpr) -> List<Mono> {
  ring_norm(rvar(i)) = [mono(suc(zero), ring_vunit(i))]
  ring_norm(rzero) = []
  ring_norm(rone) = [mono(suc(zero), [])]
  ring_norm(rconst(n)) = if n = zero then [] else [mono(n, [])]
  ring_norm(radd(a, b)) = ring_add(ring_norm(a), ring_norm(b))
  ring_norm(rsub(a, b)) = []
  ring_norm(rneg(a)) = []
  ring_norm(rmul(a, b)) = ring_mul(ring_norm(a), ring_norm(b))
  ring_norm(rpow(a, k)) = ring_npow(toNat(k), ring_norm(a))
}

recursive ring_pow<T> where { CommSemiring<T> } (Nat, T) -> T {
  ring_pow(zero, x) = one
  ring_pow(suc(n), x) = x * ring_pow(n, x)
}

recursive ring_mdenote<T> where { CommSemiring<T> } (List<Nat>, List<T>) -> T {
  ring_mdenote(empty, env) = one
  ring_mdenote(node(e, es), env) =
    ring_pow(e, ring_get(env, zero)) * ring_mdenote(es, ring_tail(env))
}

recursive ring_pdenote<T> where { CommSemiring<T> } (List<Mono>, List<T>) -> T {
  ring_pdenote(empty, env) = zero
  ring_pdenote(node(t, ps), env) =
    switch t {
      case mono(c, m) { from_nat(c) * ring_mdenote(m, env) + ring_pdenote(ps, env) }
    }
}

/********************** Semiring lemmas **********************/

lemma ring_zero_add: all T:type where { CommSemiring<T> }. all x:T. zero + x = x
proof
  arbitrary T:type where { CommSemiring<T> }
  arbitrary x:T
  replace add_commute[zero, x]
  add_zero[x]
end

lemma ring_one_mult: all T:type where { CommSemiring<T> }. all x:T. one * x = x
proof
  arbitrary T:type where { CommSemiring<T> }
  arbitrary x:T
  replace mult_commute[one, x]
  mult_one[x]
end

lemma ring_zero_mult: all T:type where { CommSemiring<T> }. all x:T. zero * x = zero
proof
  arbitrary T:type where { CommSemiring<T> }
  arbitrary x:T
  replace mult_commute[zero, x]
  mult_zero[x]
end

lemma ring_dist_right: all T:type where { CommSemiring<T> }.
  all x:T, y:T, z:T. (x + y) * z = x * z + y * z
proof
  arbitrary T:type where { CommSemiring<T> }
  arbitrary x:T, y:T, z:T
  replace mult_commute[x + y, z] | dist_mult_add[z, x, y]
        | mult_commute[z, x] | mult_commute[z, y].
end

lemma ring_add_left_comm: all T:type where { CommSemiring<T> }.
  all x:T, y:T, z:T. x + (y + z) = y + (x + z)
proof
  arbitrary T:type where { CommSemiring<T> }
  arbitrary x:T, y:T, z:T
  replace symmetric add_assoc[x, y, z] | add_commute[x, y] | add_assoc[y, x, z].
end

lemma ring_mult_shuffle: all T:type where { CommSemiring<T> }.
  all a:T, b:T, c:T, d:T. (a * b) * (c * d) = (a * c) * (b * d)
proof
  arbitrary T:type where { CommSemiring<T> }
  arbitrary a:T, b:T, c:T, d:T
  equations
        (a * b) * (c * d) = a * (b * (c * d))   by mult_assoc[a, b, c * d]
      ... = a * ((b * c) * d)   by replace symmetric mult_assoc[b, c, d].
      ... = a * ((c * b) * d)   by replace mult_commute[b, c].
      ... = a * (c * (b * d))   by replace mult_assoc[c, b, d].
      ... = (a * c) * (b * d)   by symmetric mult_assoc[a, c, b * d]
end

/********************** Soundness in a semiring **********************/

lemma ring_pow_add: all T:type where { CommSemiring<T> }.
  all a:Nat. all b:Nat, x:T.
  ring_pow(a + b, x) = ring_pow(a, x) * ring_pow(b, x)
proof
  arbitrary T:type where { CommSemiring<T> }
  induction Nat
  case zero {
    arbitrary b:Nat, x:T
    expand ring_pow
    symmetric ring_one_mult<T>
  }
  case suc(a) assume IH {
    arbitrary b:Nat, x:T
    expand operator+ | ring_pow
    replace IH[b, x]
    symmetric mult_assoc
  }
end

lemma ring_mdenote_vadd: all T:type where { CommSemiring<T> }.
  all m1:List<Nat>. all m2:List<Nat>, env:List<T>.
  ring_mdenote(ring_vadd(m1, m2), env)
  = ring_mdenote(m1, env) * ring_mdenote(m2, env)
proof
  arbitrary T:type where { CommSemiring<T> }
  induction List<Nat>
  case empty {
    arbitrary m2:List<Nat>, env:List<T>
    expand ring_vadd | ring_mdenote
    symmetric ring_one_mult<T>
  }
  case node(e, es) assume IH {
    arbitrary m2:List<Nat>, env:List<T>
    switch m2 {
      case empty {
        expand ring_vadd | ring_mdenote
        symmetric mult_one
      }
      case node(f, fs) {
        expand ring_vadd | ring_mdenote
        replace ring_pow_add<T> | IH[fs, ring_tail(env)]
        ring_mult_shuffle<T>
      }
    }
  }
end

lemma ring_mdenote_vunit: all T:type where { CommSemiring<T> }.
  all i:Nat. all env:List<T>.
  ring_mdenote(ring_vunit(i), env) = ring_get(env, i)
proof
  arbitrary T:type where { CommSemiring<T> }
  induction Nat
  case zero {
    arbitrary env:List<T>
    expand ring_vunit | 2 * ring_mdenote | 2 * ring_pow
    replace mult_one | mult_one.
  }
  case suc(j) assume IH {
    arbitrary env:List<T>
    expand ring_vunit | ring_mdenote | ring_pow
    replace IH[ring_tail(env)] | ring_one_mult<T>
    switch env {
      case empty { evaluate }
      case node(x, xs) { evaluate }
    }
  }
end

lemma ring_pdenote_insert: all T:type where { CommSemiring<T> }.
  all ps:List<Mono>. all c:Nat, m:List<Nat>, env:List<T>.
  ring_pdenote(ring_insert(ps, c, m), env)
  = from_nat(c) * ring_mdenote(m, env) + ring_pdenote(ps, env)
proof
  arbitrary T:type where { CommSemiring<T> }
  induction List<Mono>
  case empty {
    arbitrary c:Nat, m:List<Nat>, env:List<T>
    expand ring_insert | 2*ring_pdenote.
  }
  case node(t, ps) assume IH {
    arbitrary c:Nat, m:List<Nat>, env:List<T>
    switch t {
      case mono(d, m2) {
        expand ring_insert
        switch m = m2 {
          case true assume e {
            replace e
            expand ring_pdenote
            replace from_nat_add[c, d] | ring_dist_right<T> | add_assoc.
          }
          case false {
            switch ring_mono_less(m, m2) {
              case true {
                expand 2*ring_pdenote.
              }
              case false {
                expand ring_pdenote
                replace IH[c, m, env]
                ring_add_left_comm<T>
              }
            }
          }
        }
      }
    }
  }
end

lemma ring_pdenote_add: all T:type where { CommSemiring<T> }.
  all ps:List<Mono>. all qs:List<Mono>, env:List<T>.
  ring_pdenote(ring_add(ps, qs), env)
  = ring_pdenote(ps, env) + ring_pdenote(qs, env)
proof
  arbitrary T:type where { CommSemiring<T> }
  induction List<Mono>
  case empty {
    arbitrary qs:List<Mono>, env:List<T>
    expand ring_add | ring_pdenote
    symmetric ring_zero_add<T>
  }
  case node(t, ps) assume IH {
    arbitrary qs:List<Mono>, env:List<T>
    switch t {
      case mono(c, m) {
        expand ring_add | ring_pdenote
        replace ring_pdenote_insert<T> | IH[qs, env]
        symmetric add_assoc
      }
    }
  }
end

lemma ring_pdenote_scale: all T:type where { CommSemiring<T> }.
  all ps:List<Mono>. all c:Nat, m:List<Nat>, env:List<T>.
  ring_pdenote(ring_scale(ps, c, m), env)
  = (from_nat(c) * ring_mdenote(m, env)) * ring_pdenote(ps, env)
proof
  arbitrary T:type where { CommSemiring<T> }
  induction List<Mono>
  case empty {
    arbitrary c:Nat, m:List<Nat>, env:List<T>
    expand ring_scale | ring_pdenote
    symmetric mult_zero
  }
  case node(t, ps) assume IH {
    arbitrary c:Nat, m:List<Nat>, env:List<T>
    switch t {
      case mono(d, m2) {
        expand ring_scale | ring_pdenote
        replace IH[c, m, env] | from_nat_mult[c, d] | ring_mdenote_vadd<T>
              | dist_mult_add
              | ring_mult_shuffle<T>[from_nat(c), from_nat(d), ring_mdenote(m, env),
                                     ring_mdenote(m2, env)].
      }
    }
  }
end

lemma ring_pdenote_mul: all T:type where { CommSemiring<T> }.
  all ps:List<Mono>. all qs:List<Mono>, env:List<T>.
  ring_pdenote(ring_mul(ps, qs), env)
  = ring_pdenote(ps, env) * ring_pdenote(qs, env)
proof
  arbitrary T:type where { CommSemiring<T> }
  induction List<Mono>
  case empty {
    arbitrary qs:List<Mono>, env:List<T>
    expand ring_mul | ring_pdenote
    symmetric ring_zero_mult<T>
  }
  case node(t, ps) assume IH {
    arbitrary qs:List<Mono>, env:List<T>
    switch t {
      case mono(c, m) {
        expand ring_mul | ring_pdenote
        replace ring_pdenote_add<T> | ring_pdenote_scale<T> | IH[qs, env]
        symmetric ring_dist_right<T>
      }
    }
  }
end

lemma ring_pdenote_npow: all T:type where { CommSemiring<T> }.
  all n:Nat. all ps:List<Mono>, env:List<T>.
  ring_pdenote(ring_npow(n, ps), env) = ring_pow(n, ring_pdenote(ps, env))
proof
  arbitrary T:type where { CommSemiring<T> }
  induction Nat
  case zero {
    arbitrary ps:List<Mono>, env:List<T>
    expand ring_npow | ring_pow | 2*ring_pdenote | ring_mdenote
    replace from_nat_one | mult_one | add_zero.
  }
  case suc(n) assume IH {
    arbitrary ps:List<Mono>, env:List<T>
    expand ring_npow | ring_pow
    replace ring_pdenote_mul<T> | IH[ps, env].
  }
end

// The semiring's `^` is `ring_pow` on the exponent as a Nat.
lemma ring_pow_uint: all T:type where { CommSemiring<T> }.
  all x:T, k:UInt. x ^ k = ring_pow(toNat(k), x)
proof
  arbitrary T:type where { CommSemiring<T> }
  arbitrary x:T
  define P = fun k:UInt { x ^ k = ring_pow(toNat(k), x) }
  have base: P(0) by {
    expand P
    have z: toNat(fromNat(ℕ0)) = zero by uint_toNat_fromNat[ℕ0]
    replace pow_zero | z
    expand ring_pow.
  }
  have step: all m:UInt. if P(m) then P(1 + m) by {
    arbitrary m:UInt
    assume IH
    expand P
    have toNat_one: toNat(fromNat(ℕ1)) = ℕ1 by uint_toNat_fromNat[ℕ1]
    have nat_eq: toNat((1:UInt) + m) = suc(toNat(m)) by {
      replace toNat_add | toNat_one
      evaluate
    }
    replace pow_one_add | nat_eq | (expand P in IH)
    expand ring_pow.
  }
  arbitrary k:UInt
  have all_P: all n:UInt. P(n) by apply uint_induction[P] to base, step
  expand P in all_P[k]
end

// The normal form denotes the expression.
lemma ring_norm_sound: all T:type where { CommSemiring<T> }.
  all e:RExpr. all env:List<T>.
  ring_pdenote(ring_norm(e), env) = ring_sdenote(e, env)
proof
  arbitrary T:type where { CommSemiring<T> }
  induction RExpr
  case rvar(i) {
    arbitrary env:List<T>
    expand ring_norm | ring_sdenote | 2*ring_pdenote
    replace ring_mdenote_vunit<T> | from_nat_one | ring_one_mult<T> | add_zero.
  }
  case rzero {
    arbitrary env:List<T>
    expand ring_norm | ring_sdenote | ring_pdenote.
  }
  case rone {
    arbitrary env:List<T>
    expand ring_norm | ring_sdenote | 2*ring_pdenote | ring_mdenote
    replace from_nat_one | mult_one | add_zero.
  }
  case rconst(n) {
    arbitrary env:List<T>
    expand ring_norm | ring_sdenote
    switch n = zero {
      case true assume n0 {
        replace n0
        expand ring_pdenote
        symmetric from_nat_zero
      }
      case false {
        expand 2*ring_pdenote | ring_mdenote
        replace mult_one | add_zero.
      }
    }
  }
  case radd(a, b) assume IHa, IHb {
    arbitrary env:List<T>
    expand ring_norm | ring_sdenote
    replace ring_pdenote_add<T> | IHa[env] | IHb[env].
  }
  case rsub(a, b) assume IHa, IHb {
    arbitrary env:List<T>
    expand ring_norm | ring_sdenote | ring_pdenote.
  }
  case rneg(a) assume IHa {
    arbitrary env:List<T>
    expand ring_norm | ring_sdenote | ring_pdenote.
  }
  case rmul(a, b) assume IHa, IHb {
    arbitrary env:List<T>
    expand ring_norm | ring_sdenote
    replace ring_pdenote_mul<T> | IHa[env] | IHb[env].
  }
  case rpow(a, k) assume IHa {
    arbitrary env:List<T>
    expand ring_norm | ring_sdenote
    replace ring_pdenote_npow<T> | IHa[env] | ring_pow_uint<T>[ring_sdenote(a, env), k].
  }
end

theorem semiring_prove: all T:type where { CommSemiring<T> }.
  all env:List<T>, a:RExpr, b:RExpr.
  if ring_norm(a) = ring_norm(b)
  then ring_sdenote(a, env) = ring_sdenote(b, env)
proof
  arbitrary T:type where { CommSemiring<T> }
  arbitrary env:List<T>, a:RExpr, b:RExpr
  assume eq
  replace symmetric ring_norm_sound<T>[a, env] | symmetric ring_norm_sound<T>[b, env]
        | eq.
end

/********************** Soundness in a ring **********************/

// The difference of two polynomials, the value of a ring expression.
union PN { pn(List<Mono>, List<Mono>) }

fun pn_pos(x : PN) { switch x { case pn(p, n) { p } } }
fun pn_neg(x : PN) { switch x { case pn(p, n) { n } } }

fun pn_add(x : PN, y : PN) {
  pn(ring_add(pn_pos(x), pn_pos(y)), ring_add(pn_neg(x), pn_neg(y)))
}

fun pn_swap(x : PN) { pn(pn_neg(x), pn_pos(x)) }

fun pn_mul(x : PN, y : PN) {
  pn(ring_add(ring_mul(pn_pos(x), pn_pos(y)), ring_mul(pn_neg(x), pn_neg(y))),
     ring_add(ring_mul(pn_pos(x), pn_neg(y)), ring_mul(pn_neg(x), pn_pos(y))))
}

recursive pn_npow(Nat, PN) -> PN {
  pn_npow(zero, x) = pn(ring_norm(rone), [])
  pn_npow(suc(n), x) = pn_mul(x, pn_npow(n, x))
}

recursive ring_pn(RExpr) -> PN {
  ring_pn(rvar(i)) = pn(ring_norm(rvar(i)), [])
  ring_pn(rzero) = pn([], [])
  ring_pn(rone) = pn(ring_norm(rone), [])
  ring_pn(rconst(n)) = pn(ring_norm(rconst(n)), [])
  ring_pn(radd(a, b)) = pn_add(ring_pn(a), ring_pn(b))
  ring_pn(rsub(a, b)) = pn_add(ring_pn(a), pn_swap(ring_pn(b)))
  ring_pn(rneg(a)) = pn_swap(ring_pn(a))
  ring_pn(rmul(a, b)) = pn_mul(ring_pn(a), ring_pn(b))
  ring_pn(rpow(a, k)) = pn_npow(toNat(k), ring_pn(a))
}

// `a - b` is `(P(a) - N(a)) - (P(b) - N(b))`, which is zero when
// `P(a) + N(b) = P(b) + N(a)`.
fun ring_pn_eq(a : RExpr, b : RExpr) {
  ring_add(pn_pos(ring_pn(a)), pn_neg(ring_pn(b)))
  = ring_add(pn_pos(ring_pn(b)), pn_neg(ring_pn(a)))
}

// If x = p - n and y = q - m, and p - n = q - m, then x = y.
lemma ring_pn_cancel: all T:type where { CommRing<T> }.
  all x:T, y:T, p:T, q:T, n:T, m:T.
  if x + n = p and y + m = q and p + m = q + n then x = y
proof
  arbitrary T:type where { CommRing<T> }
  arbitrary x:T, y:T, p:T, q:T, n:T, m:T
  assume h
  have xnm: x + (n + m) = y + (n + m) by
    equations
          x + (n + m) = (x + n) + m     by algebra
        ... = p + m                     by replace conjunct 0 of h.
        ... = q + n                     by conjunct 2 of h
        ... = (y + m) + n               by replace symmetric conjunct 1 of h.
        ... = y + (n + m)               by algebra
  equations
        x = #x + ((n + m) + - (n + m))#     by replace add_inverse | add_zero.
      ... = (x + (n + m)) + - (n + m)       by algebra
      ... = (y + (n + m)) + - (n + m)       by replace xnm.
      ... = y + ((n + m) + - (n + m))       by algebra
      ... = y                               by replace add_inverse | add_zero.
end

lemma ring_pn_sub: all T:type where { CommRing<T> }.
  all x:T, y:T, n:T, m:T. (x - y) + (n + (y + m)) = (x + n) + m
proof
  arbitrary T:type where { CommRing<T> }
  arbitrary x:T, y:T, n:T, m:T
  replace sub_def
  equations
        (x + - y) + (n + (y + m)) = ((x + n) + m) + (y + - y)   by algebra
      ... = (x + n) + m                                        by replace add_inverse | add_zero.
end

lemma ring_pn_neg: all T:type where { CommRing<T> }.
  all x:T, n:T. - x + (x + n) = n
proof
  arbitrary T:type where { CommRing<T> }
  arbitrary x:T, n:T
  equations
        - x + (x + n) = n + (x + - x)   by algebra
      ... = n                           by replace add_inverse | add_zero.
end

lemma pn_pos_pn: all p:List<Mono>, n:List<Mono>. pn_pos(pn(p, n)) = p
proof
  arbitrary p:List<Mono>, n:List<Mono>
  expand pn_pos.
end

lemma pn_neg_pn: all p:List<Mono>, n:List<Mono>. pn_neg(pn(p, n)) = n
proof
  arbitrary p:List<Mono>, n:List<Mono>
  expand pn_neg.
end

// If x = P(X) - N(X) and y = P(Y) - N(Y), then x * y is the value of
// their product.
lemma pn_mul_sound: all T:type where { CommRing<T> }.
  all x:T, y:T, X:PN, Y:PN, env:List<T>.
  if x + ring_pdenote(pn_neg(X), env) = ring_pdenote(pn_pos(X), env)
     and y + ring_pdenote(pn_neg(Y), env) = ring_pdenote(pn_pos(Y), env)
  then x * y + ring_pdenote(pn_neg(pn_mul(X, Y)), env)
     = ring_pdenote(pn_pos(pn_mul(X, Y)), env)
proof
  arbitrary T:type where { CommRing<T> }
  arbitrary x:T, y:T, X:PN, Y:PN, env:List<T>
  assume h
  expand pn_mul
  replace pn_pos_pn | pn_neg_pn | ring_pdenote_add<T> | ring_pdenote_mul<T>
        | symmetric conjunct 0 of h | symmetric conjunct 1 of h
  algebra
end

lemma pn_npow_sound: all T:type where { CommRing<T> }.
  all n:Nat. all x:T, X:PN, env:List<T>.
  if x + ring_pdenote(pn_neg(X), env) = ring_pdenote(pn_pos(X), env)
  then ring_pow(n, x) + ring_pdenote(pn_neg(pn_npow(n, X)), env)
     = ring_pdenote(pn_pos(pn_npow(n, X)), env)
proof
  arbitrary T:type where { CommRing<T> }
  induction Nat
  case zero {
    arbitrary x:T, X:PN, env:List<T>
    assume h
    expand pn_npow | ring_pow
    replace pn_pos_pn | pn_neg_pn | ring_norm_sound<T>
    expand ring_sdenote | ring_pdenote
    add_zero
  }
  case suc(n) assume IH {
    arbitrary x:T, X:PN, env:List<T>
    assume h
    expand pn_npow | ring_pow
    apply pn_mul_sound<T>[x, ring_pow(n, x), X, pn_npow(n, X), env]
      to h, (apply IH[x, X, env] to h)
  }
end

// The value of an expression is P - N, stated without subtraction.
lemma ring_pn_sound: all T:type where { CommRing<T> }.
  all e:RExpr. all env:List<T>.
  ring_denote(e, env) + ring_pdenote(pn_neg(ring_pn(e)), env)
  = ring_pdenote(pn_pos(ring_pn(e)), env)
proof
  arbitrary T:type where { CommRing<T> }
  induction RExpr
  case rvar(i) {
    arbitrary env:List<T>
    expand ring_pn
    replace pn_pos_pn | pn_neg_pn | ring_norm_sound<T>
    expand ring_denote | ring_sdenote | ring_pdenote
    add_zero
  }
  case rzero {
    arbitrary env:List<T>
    expand ring_pn
    replace pn_pos_pn | pn_neg_pn
    expand ring_denote | ring_pdenote
    add_zero
  }
  case rone {
    arbitrary env:List<T>
    expand ring_pn
    replace pn_pos_pn | pn_neg_pn | ring_norm_sound<T>
    expand ring_denote | ring_sdenote | ring_pdenote
    add_zero
  }
  case rconst(n) {
    arbitrary env:List<T>
    expand ring_pn
    replace pn_pos_pn | pn_neg_pn | ring_norm_sound<T>
    expand ring_denote | ring_sdenote | ring_pdenote
    add_zero
  }
  case radd(a, b) assume IHa, IHb {
    arbitrary env:List<T>
    expand ring_pn | pn_add | ring_denote
    replace pn_pos_pn | pn_neg_pn | ring_pdenote_add<T> | symmetric IHa[env] | symmetric IHb[env]
    algebra
  }
  case rsub(a, b) assume IHa, IHb {
    arbitrary env:List<T>
    expand ring_pn | pn_swap | pn_add | ring_denote
    replace pn_pos_pn | pn_neg_pn | pn_pos_pn | pn_neg_pn | ring_pdenote_add<T> | symmetric IHa[env] | symmetric IHb[env]
    ring_pn_sub<T>
  }
  case rneg(a) assume IHa {
    arbitrary env:List<T>
    expand ring_pn | pn_swap | ring_denote
    replace pn_pos_pn | pn_neg_pn | symmetric IHa[env]
    ring_pn_neg<T>
  }
  case rmul(a, b) assume IHa, IHb {
    arbitrary env:List<T>
    expand ring_pn | ring_denote
    apply pn_mul_sound<T> to IHa[env], IHb[env]
  }
  case rpow(a, k) assume IHa {
    arbitrary env:List<T>
    expand ring_pn | ring_denote
    replace ring_pow_uint<T>[ring_denote(a, env), k]
    apply pn_npow_sound<T>[toNat(k)][ring_denote(a, env), ring_pn(a), env] to IHa[env]
  }
end

theorem ring_prove: all T:type where { CommRing<T> }.
  all env:List<T>, a:RExpr, b:RExpr.
  if ring_pn_eq(a, b)
  then ring_denote(a, env) = ring_denote(b, env)
proof
  arbitrary T:type where { CommRing<T> }
  arbitrary env:List<T>, a:RExpr, b:RExpr
  assume h
  have e: ring_pdenote(pn_pos(ring_pn(a)), env) + ring_pdenote(pn_neg(ring_pn(b)), env)
        = ring_pdenote(pn_pos(ring_pn(b)), env) + ring_pdenote(pn_neg(ring_pn(a)), env)
    by replace symmetric ring_pdenote_add<T> | (expand ring_pn_eq in h).
  apply ring_pn_cancel<T> to ring_pn_sound<T>[a, env], ring_pn_sound<T>[b, env], e
end
