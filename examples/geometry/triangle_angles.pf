// triangle_angles.pf
//
// Finding missing angles, an exercise from a high school geometry
// course:
//
//   Given: △ABC with m∠A = 50° and m∠B = 60°, and D on ray BC
//          beyond C.
//   Find: m∠ACB and the exterior angle m∠ACD.
//
//                 A
//                / \
//               /   \
//              /     \
//             B-------C-------D
//
// The two-column proof:
//
//   Statements                       Reasons
//   1. m∠A + m∠B + m∠ACB = 180°      Triangle Angle Sum Theorem
//   2. 50° + 60° + m∠ACB = 180°      Substitution (given, 1)
//   3. m∠ACB = 70°                   Subtraction (2)
//   4. m∠ACD = m∠A + m∠B             Exterior Angle Theorem
//   5. m∠ACD = 110°                  Substitution (given, 4)
//
// Here ∠A is ∠CAB and ∠B is ∠ABC.

theorem triangle_angles: all A:Point, B:Point, C:Point, D:Point.
  if triangle(A, B, C) and between(B, C, D)
     and m_angle(C, A, B) = deg(+50) and m_angle(A, B, C) = deg(+60)
  then m_angle(A, C, B) = deg(+70) and m_angle(A, C, D) = deg(+110)
proof
  arbitrary A:Point, B:Point, C:Point, D:Point
  assume given
  have t: triangle(A, B, C) by given
  have a: m_angle(C, A, B) = deg(+50) by given
  have b: m_angle(A, B, C) = deg(+60) by given
  have step1: m_angle(C, A, B) + m_angle(A, B, C) + m_angle(B, C, A) = deg(+180)
    by apply tri_angle_sum to t                                     // Triangle Angle Sum Theorem
  have step2: deg(+50) + deg(+60) + m_angle(A, C, B) = deg(+180)
    by replace a | b | angle_measure_symmetric[B, C, A] in step1     // Substitution
  have step3: m_angle(A, C, B) = deg(+70)
    by algebra with step2                                           // Subtraction
  have step4: m_angle(A, C, D) = m_angle(C, A, B) + m_angle(A, B, C)
    by apply tri_exterior_angle to t, (conjunct 1 of given)         // Exterior Angle Theorem
  have step5: m_angle(A, C, D) = deg(+110)
    by replace a | b in step4                                       // Substitution
  (step3, step5)
end
