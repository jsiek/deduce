// midsegment.pf
//
// The midsegment theorem of a high school geometry course:
//
//   The segment joining the midpoints of two sides of a triangle is
//   parallel to the third side and half as long.
//
//                 A
//                / \
//               /   \
//            M +-----+ N
//             /       \
//            /         \
//         B +-----------+ C
//
// The coordinates of A, B, and C are arbitrary, so the proof covers
// every triangle. The two-column proof:
//
//   Statements                       Reasons
//   1. 4 MN² = BC²                   Midpoint and distance formulas
//   2. M ≠ N                         If M = N then MN² = 0, so BC² = 0
//                                    and B = C, but B ≠ C (1)
//   3. MN × BC = 0                   Midpoint formula, cross product
//   4. MN ∥ BC                       Lines with a zero cross product
//                                    are parallel (2, 3)
//
// Distances are squared (`dist2`), so "half as long" is 4 MN² = BC².

theorem midsegment: all A:Point, B:Point, C:Point.
  if not (B = C)
  then parallel(line(midpoint(A, B), midpoint(A, C)), line(B, C))
   and real(+4) * dist2(midpoint(A, B), midpoint(A, C)) = dist2(B, C)
proof
  arbitrary A:Point, B:Point, C:Point
  assume b_ne_c
  define M = midpoint(A, B)
  define N = midpoint(A, C)

  // The vector from M to N is half the vector from B to C.
  have hx: xcoord(N) - xcoord(M) = real(frac(+1, 2)) * (xcoord(C) - xcoord(B))
    by { expand M | N | midpoint  algebra }
  have hy: ycoord(N) - ycoord(M) = real(frac(+1, 2)) * (ycoord(C) - ycoord(B))
    by { expand M | N | midpoint  algebra }
  have step1: real(+4) * dist2(M, N) = dist2(B, C) by {
    // Distance formula
    replace point_dist2_symmetric[M, N]
    expand dist2
    replace hx | hy
    algebra
  }
  have step2: not (M = N) by {
    assume m_eq_n
    have mn0: dist2(M, N) = real(+0) by { replace m_eq_n  point_dist2_self[N] }
    have bc0: dist2(B, C) = real(+0) by { replace symmetric step1 | mn0. }
    apply b_ne_c to replace point_dist2_zero[B, C] in bc0
  }
  have step3: seg_cross(M, N, B, C) = real(+0) by {
    // Cross product
    expand seg_cross
    replace hx | hy
    algebra
  }
  have step4: parallel(line(M, N), line(B, C)) by {
    // Lines with a zero cross product are parallel
    replace apply line_parallel_seg_cross[M, N, B, C] to step2, b_ne_c
    step3
  }
  (step4, step1)
end
